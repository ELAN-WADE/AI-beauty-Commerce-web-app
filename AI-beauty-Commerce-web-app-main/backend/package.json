{
  "name": "glowly-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "postcss": "^8.5.28"
  },
  "scripts": {
    "assets:sync": "node scripts/sync-public-assets.mjs",
    "predev": "npm run assets:sync",
    "dev": "next dev -p 3005 --hostname 127.0.0.1",
    "prebuild": "npm run assets:sync",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:postgres": "node scripts/test-postgres.mjs",
    "db:local": "node scripts/postgres-local.mjs",
    "db:check": "node scripts/check-postgres.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "dev:access": "tsx scripts/local-access.ts",
    "db:seed:catalog": "tsx src/db/seed-catalog.ts",
    "db:seed:partners": "tsx src/db/seed-partners.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:once": "tsx src/worker/index.ts --once",
    "admin:local": "tsx scripts/bootstrap-local-admin.ts",
    "auth:check": "tsx scripts/check-auth-config.ts",
    "worker:auth": "tsx scripts/auth-email-worker.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-dev-admin.ts",
    "render:deploy": "npm run db:migrate && npm run db:seed && npm run db:seed:catalog && npm run db:seed:partners && npm run admin:bootstrap"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@hugeicons/react": "^0.3.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/supabase-js": "^2.117.2",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "dotenv": "^16.4.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.0.0",
    "nodemailer": "^10.0.12",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.1",
    "three": "^0.186.1",
    "tsx": "^4.19.0",
    "zod": "^3.23.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^14.3.0",
    "ogl": "^1.0.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.30.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "description": "Modular monolith (S0 auth/users; catalog in S2). Supabase is prototype-only;\r this is the production path you own: database, credentials, schema, migrations,\r backups, secrets.",
  "main": "tailwind.config.js",
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}

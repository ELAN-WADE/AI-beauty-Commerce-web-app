# Copy to .env (dev) / set as secrets per environment (staging/prod).
# NEVER commit .env. NEVER expose these via NEXT_PUBLIC_*.

# Owned PostgreSQL (docker compose default; staging/prod override)
DATABASE_URL=postgres://glowly:glowly_dev_only@localhost:5432/glowly_dev
# Optional postgres.js TLS mode. Use require/verify-full for remote managed DBs;
# private local/VPS networks may leave this unset or set disable.
DATABASE_SSL_MODE=disable

# App (the full-stack Next.js deployment can use one origin for both values;
# local development uses the separate backend and storefront ports shown here)
APP_URL=http://localhost:3005
NODE_ENV=development
SESSION_TTL_DAYS=30

# Google OAuth (server-only). Set the callback to
# `${FRONTEND_URL}/api/auth/oauth/google/callback` and register it in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/oauth/google/callback

# Object storage (MinIO dev defaults; R2/S3 in staging/prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY=glowly
S3_SECRET_KEY=glowlyminio123
# Private bucket for face-scan images (never public; signed URLs only)
SCANS_BUCKET=glowly-scans
# Public bucket for community images/video (public GET; writes via presigned PUT only)
COMMUNITY_BUCKET=glowly-community
# Public base URL for community media (custom CDN domain when set; falls back to S3/MinIO URL)
COMMUNITY_MEDIA_BASE_URL=

# Email: smtp or brevo (HTTPS). Leave unset for local MailHog defaults.
EMAIL_TRANSPORT=smtp
# Optional: EMAIL_FROM/EMAIL_FROM_NAME override the SMTP_FROM sender.
EMAIL_FROM=
EMAIL_FROM_NAME=Desla!
# HTTPS alternative. Use a Brevo API key, NOT the SMTP key.
BREVO_API_KEY=
# embedded runs account emails in the Render web service; external uses worker:auth.
AUTH_EMAIL_WORKER_MODE=external
# MailHog dev defaults. On Render Free use Brevo port 2525 with SMTP_SECURE=false
# (STARTTLS is still required), or EMAIL_TRANSPORT=brevo over HTTPS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Glowly <hello@example.com>"
# SMTP_USER= / SMTP_PASS= — optional in development; required in production.
# SMTP_SECURE=true for implicit TLS (port 465). Render Free blocks 465/587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Production: separate KMS-managed 32-byte hex key; rotate with an outbox drain.
AUTH_EMAIL_ENCRYPTION_KEY=
# Separate key for TOTP secrets; rotate using the MFA re-enrollment procedure.
MFA_ENCRYPTION_KEY=
# Production reverse proxy strips and sets this header. Shared DB limits protect writes;
# edge/WAF rate limits are recommended as an additional layer.
CLIENT_IP_HEADER=x-verified-client-ip

# Termii SMS/WhatsApp (Nigeria-first notifications; log-driver when unset)
TERMII_API_KEY=
TERMII_SENDER_ID=Glowly
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SEND_PATH=/api/sms/send

# Error monitoring (Sentry; no-op clients when unset)
SENTRY_DSN=

# Worker loop interval (ms); --once flag for cron-style single passes
WORKER_INTERVAL_MS=60000

# Payments (test keys in dev only; live keys are staging/prod secrets)
# Keep false while validating the admin and partner workflows. No provider reconciliation runs.
PAYMENTS_ENABLED=false
# Stripe = international cards (Checkout Sessions + webhooks)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
FLW_SECRET_KEY=FLWSECK_TEST-placeholder
FLW_SECRET_HASH=random-webhook-hash-placeholder
FLW_BASE_URL=https://api.flutterwave.com/v3
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_BASE_URL=https://liveapi.opaycheckout.com
# CONFIRM against merchant dashboard docs at onboarding (env-only change):
OPAY_CREATE_PATH=/api/v1/international/cashier/create
OPAY_STATUS_PATH=/api/v1/international/cashier/status

# Business bank account for direct-transfer checkout (displayed to customer)
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Public storefront URL (provider redirect target + CORS allowlist)
FRONTEND_URL=http://localhost:3002

# Partner earnings (ledger defaults; override per environment, never per order)
COMMISSION_HOLD_DAYS=14
MIN_PAYOUT_KOBO=1000000

# Creator content rewards (weekly settlement from attributed orders; 0 pauses the program)
CONTENT_REWARD_BPS=200
CONTENT_REWARD_MIN_MERCHANDISE_KOBO=50000
CONTENT_REWARD_HOLD_DAYS=14

# AI (server-side only; live analysis is unavailable until configured)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Server-only private admin page; use the same long random value in both apps.
ADMIN_ENTRY_PATH=
ADMIN_GOOGLE_EMAIL=deslaadmin@gmail.com
# Optional startup provisioning. Email must match ADMIN_GOOGLE_EMAIL.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Set true temporarily to apply the configured password to an existing admin,
# clear its login lockout, and revoke sessions/reset links if the password changes.
ADMIN_BOOTSTRAP_SYNC_PASSWORD=false

# Creator social profile connections. Keep all values server-side.
# Register these exact HTTPS paths on the SAME first-party site used by creators:
# /api/creator/social/tiktok/callback
# /api/creator/social/instagram/callback
SOCIAL_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
INSTAGRAM_REDIRECT_URI=

# Public HTTPS storefront origin used for canonicals, robots and sitemaps.
PUBLIC_SITE_URL=

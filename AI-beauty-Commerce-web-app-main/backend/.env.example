# Copy to .env (dev) / set as secrets per environment (staging/prod).
# NEVER commit .env. NEVER expose these via NEXT_PUBLIC_*.

# Owned PostgreSQL (docker compose default; staging/prod override)
DATABASE_URL=postgres://glowly:glowly_dev_only@localhost:5432/glowly_dev

# App
APP_URL=http://localhost:3001
NODE_ENV=development
SESSION_TTL_DAYS=30

# Object storage (MinIO dev defaults; R2/S3 in staging/prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=glowly-dev
S3_ACCESS_KEY=glowly
S3_SECRET_KEY=glowlyminio123
# Private bucket for face-scan images (never public; signed URLs only)
SCANS_BUCKET=glowly-scans

# Email (MailHog dev defaults; SMTP provider in staging/prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Glowly <hello@example.com>"
# SMTP_USER= / SMTP_PASS= / SMTP_SECURE= (true for 465) — unset = log driver
# Production: separate KMS-managed 32-byte hex key; rotate with an outbox drain.
AUTH_EMAIL_ENCRYPTION_KEY=
# Production reverse proxy strips and sets this header; edge must apply shared rate limits.
CLIENT_IP_HEADER=x-verified-client-ip
EDGE_RATE_LIMIT_ENABLED=false

# Termii SMS/WhatsApp (Nigeria-first notifications; log-driver when unset)
TERMII_API_KEY=
TERMII_SENDER_ID=Glowly
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SEND_PATH=/api/sms/send

# Error monitoring (Sentry; no-op clients when unset)
SENTRY_DSN=

# Worker loop interval (ms); --once flag for cron-style single passes
WORKER_INTERVAL_MS=60000

# Payments (S4 — test keys in dev only; live keys are staging/prod secrets)
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYSTACK_BASE_URL=https://api.paystack.co
FLW_SECRET_KEY=FLWSECK_TEST-placeholder
FLW_SECRET_HASH=random-webhook-hash-placeholder
FLW_BASE_URL=https://api.flutterwave.com/v3
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_BASE_URL=https://liveapi.opaycheckout.com
# CONFIRM against merchant dashboard docs at onboarding (env-only change):
OPAY_CREATE_PATH=/api/v1/international/cashier/create
OPAY_STATUS_PATH=/api/v1/international/cashier/status

# Business bank account for direct-transfer checkout (displayed to customer)
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Public app URL (provider redirect/callback targets + CORS allowlist seed)
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Partner earnings (ledger defaults; override per environment, never per order)
COMMISSION_HOLD_DAYS=14
MIN_PAYOUT_KOBO=1000000

# Creator content rewards (weekly settlement from attributed orders; 0 pauses the program)
CONTENT_REWARD_BPS=200
CONTENT_REWARD_MIN_MERCHANDISE_KOBO=50000
CONTENT_REWARD_HOLD_DAYS=14

# AI (S6 — server-side only; mock provider when unset, responses labelled)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Redis (optional until multi-instance; rate limits fall back to in-process)
REDIS_URL=redis://localhost:6379

# Desla!™ Backend env — copy to .env and fill.
# Vite only exposes VITE_* vars to the browser. Never put service_role here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Upstash Redis (cache only — optional locally, in-memory fallback applies)
VITE_UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Owned backend (Glowly S2+): Next.js API base URL. When set, the catalogue
# hydrates from the owned API (same-origin /api in production via nginx).
# When unset, the storefront runs on local mocks.
VITE_API_URL=http://localhost:3001

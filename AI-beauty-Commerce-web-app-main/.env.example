# Desla!™ Backend env — copy to .env and fill.
# Vite only exposes VITE_* vars to the browser. Never put service_role here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Upstash Redis (cache only — optional locally, in-memory fallback applies)
VITE_UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional only when deploying this root storefront separately from the
# full-stack backend Next.js app. For the single-app deployment, omit it and let
# the same Next.js app serve its own /api/* routes.
API_UPSTREAM_URL=http://localhost:3005

# Server-only private admin page; use the same long random value in both apps.
ADMIN_ENTRY_PATH=
ADMIN_GOOGLE_EMAIL=deslaadmin@gmail.com

# Public HTTPS storefront origin used for canonicals, robots and sitemaps.
PUBLIC_SITE_URL=

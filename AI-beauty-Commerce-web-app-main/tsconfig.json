{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    ".journey-browser/types/**/*.ts",
    ".next-browser/types/**/*.ts",
    ".next-dev-3000/types/**/*.ts",
    ".next-dev-3001/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-portal-acceptance/types/**/*.ts",
    ".next/types/**/*.ts",
    ".portal-build-production/types/**/*.ts",
    ".portal-build/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".performance-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backend"
  ]
}
